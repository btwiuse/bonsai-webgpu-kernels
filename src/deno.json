{
  "fmt": {
    "include": ["**/*.js", "**/*.css", "**/*.md"],
    "exclude": ["../buildless.html", "model/index-runtime.js"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "include": ["**/*.js"],
    "exclude": ["../buildless.html", "model/index-runtime.js"]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt-check": "deno fmt --check",
    "lint": "deno lint"
  }
}